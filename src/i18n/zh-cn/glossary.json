{
  "$comment": "Terminology contract for zh-cn. Kiro invents most of these terms, so pinning them down early keeps translations consistent as contributors join. `keepEnglish: true` means the English word stays in the translated string.",
  "locale": "zh-cn",
  "terms": [
    { "en": "Kiro", "zh": "Kiro", "keepEnglish": true, "note": "产品名，不译" },
    { "en": "Agent", "zh": "智能体", "keepEnglish": false },
    { "en": "Agent Focus", "zh": "聚焦智能体", "keepEnglish": false, "note": "产品模式名；修饰语在前，勿译成「智能体聚焦模式」" },
    { "en": "Spec", "zh": "规格", "keepEnglish": false, "note": "对应 .kiro/specs；短标签可用 Spec" },
    { "en": "Steering", "zh": "指引", "keepEnglish": false, "note": "Steering document -> 指引文档；勿用「引导」（太泛）" },
    { "en": "Skill", "zh": "技能", "keepEnglish": false },
    { "en": "Hook", "zh": "钩子", "keepEnglish": false },
    { "en": "Power", "zh": "能力", "keepEnglish": false, "note": "Powers 面板标题用「能力」" },
    { "en": "Checkpoint", "zh": "检查点", "keepEnglish": false },
    { "en": "Session", "zh": "会话", "keepEnglish": false },
    { "en": "Autopilot", "zh": "自动模式", "keepEnglish": false, "note": "勿用「自动驾驶」（车机感）" },
    { "en": "Supervised", "zh": "确认模式", "keepEnglish": false, "note": "改动前需你确认；勿用「监督」" },
    { "en": "Vibe", "zh": "Vibe", "keepEnglish": true, "note": "与 Spec 并列的会话类型，保留原词" },
    { "en": "MCP", "zh": "MCP", "keepEnglish": true, "note": "Model Context Protocol，保留" },
    { "en": "ACP", "zh": "ACP", "keepEnglish": true, "note": "Agent Client Protocol，保留" },
    { "en": "Requirements", "zh": "需求", "keepEnglish": false },
    { "en": "Design", "zh": "设计", "keepEnglish": false },
    { "en": "Task list", "zh": "任务列表", "keepEnglish": false },
    { "en": "Bugfix", "zh": "修 Bug", "keepEnglish": false },
    { "en": "Context", "zh": "上下文", "keepEnglish": false },
    { "en": "Autocomplete", "zh": "自动补全", "keepEnglish": false },
    { "en": "Shell integration", "zh": "Shell 集成", "keepEnglish": true, "note": "Shell 保留原词" },
    { "en": "Trust", "zh": "信任", "keepEnglish": false },
    { "en": "Permissions", "zh": "权限", "keepEnglish": false },
    { "en": "Execution", "zh": "执行", "keepEnglish": false },
    { "en": "Tool card", "zh": "工具卡片", "keepEnglish": false },
    { "en": "Workspace", "zh": "工作区", "keepEnglish": false, "note": "沿用 VS Code 官方中文译法" },
    { "en": "Workspace Manager", "zh": "工作区管理", "keepEnglish": false, "note": "勿加「编排器」括注" },
    { "en": "Command Palette", "zh": "命令面板", "keepEnglish": false, "note": "沿用 VS Code 官方中文译法" },
    { "en": "Agent autonomy", "zh": "自主程度", "keepEnglish": false }
  ],
  "style": {
    "punctuation": "中文全角标点；括号用（），但保留占位符与命令链接中的半角原样",
    "placeholders": "{0}、{1} 等占位符必须原样保留，数量与顺序不得改变",
    "codicons": "$(icon-name) 图标标记必须原样保留",
    "commandLinks": "Markdown 命令链接 [文本](command:xxx) 中的 command: 部分不得翻译",
    "keybindings": "快捷键写法如 ⌘Enter / Ctrl+Enter 保持原样",
    "spacing": "中文与英文、数字之间加一个半角空格",
    "wordOrder": "修饰语在前、中心词在后（如「聚焦智能体」而非「智能体聚焦模式」）；少用「…模式」叠床架屋",
    "tone": "偏口语、短标签；避免公文腔（监督、规范、存活、演练、结构化流程）"
  }
}
