  // Simplified Chinese translations for the Kiro built-in extension `kiro.kiroAgent`.
  //
  // `contents.package` overrides the extension's package.nls.json, which backs every
  // %key% placeholder in its manifest: command titles, view names, editor titles,
  // spec toolbar buttons and tree view welcome text.
  //
  // `contents.bundle` would override runtime vscode.l10n.t() strings. Kiro declares
  // "l10n" in its manifest but does not call l10n.t() yet, so the section is left
  // empty on purpose - it starts working the moment Kiro adopts the API.
  //
  // Comments are stripped by the build. The English source is kept inline so reviews
  // do not require a second file. Rules: keep {0} placeholders, $(codicon) markers,
  // command: links and keyboard glyphs exactly as they are.
  "version": "1.0.0",
  "contents": {
